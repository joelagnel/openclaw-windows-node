<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.SetupEngine.UI.Pages.CapabilitiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:setup="using:OpenClaw.SetupEngine.UI"
    NavigationCacheMode="Disabled">

    <Grid RowDefinitions="Auto,*,Auto" Padding="48,28,48,24">

        <StackPanel Grid.Row="0" Spacing="8" HorizontalAlignment="Center">
            <Image Source="ms-appx:///OpenClaw.SetupEngine.UI/Assets/Setup/OpenClawMascot.png"
                   Width="44" Height="44" HorizontalAlignment="Center"
                   AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="Set up the WSL gateway"
                       Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Capped content column keeps transcript rows and the active card aligned across steps and shrinks in narrow windows. -->
        <Grid Grid.Row="1" Margin="0,24,0,16">
            <ScrollViewer x:Name="Scroller" MaxWidth="600"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" HorizontalAlignment="Stretch">

                    <StackPanel x:Name="Transcript" Spacing="6" />

                    <Border x:Name="ActiveCard"
                            CornerRadius="4"
                            Padding="16"
                            MinHeight="160"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="14">
                            <TextBlock x:Name="StepTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"
                                       AutomationProperties.HeadingLevel="Level2" />

                            <StackPanel x:Name="Step1Content" Spacing="8">
                                <TextBlock setup:SetupText.Uid="Onboarding_SecurityLevel_Intro" TextWrapping="Wrap"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="This controls what OpenClaw can do on this PC. You can change it later on the Permissions page." />
                                <RadioButtons x:Name="ProfileRadio" SelectionChanged="Profile_Changed" MaxColumns="1"
                                              setup:SetupText.Uid="Onboarding_SecurityLevel_Group" AutomationProperties.Name="Access level">
                                    <RadioButton setup:SetupText.Uid="Onboarding_SecurityLevel_LookOnly" AutomationProperties.Name="Look only">
                                        <StackPanel Spacing="1">
                                            <TextBlock setup:SetupText.Uid="Onboarding_SecurityLevel_LookOnlyTitle" Text="Look only"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock setup:SetupText.Uid="Onboarding_SecurityLevel_LookOnlyDetail"
                                                       Text="Sees your screen and shows content in a canvas window. Can't run commands or programs."
                                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton setup:SetupText.Uid="Onboarding_SecurityLevel_Balanced" AutomationProperties.Name="Balanced (Recommended)">
                                        <StackPanel Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock setup:SetupText.Uid="Onboarding_SecurityLevel_BalancedTitle" Text="Balanced"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                                <Border CornerRadius="4" Padding="7,1" VerticalAlignment="Center"
                                                        BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}" BorderThickness="1">
                                                    <TextBlock setup:SetupText.Uid="Onboarding_SecurityLevel_RecommendedBadge" Text="Recommended"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock setup:SetupText.Uid="Onboarding_SecurityLevel_BalancedDetail"
                                                       Text="Also runs commands and programs, and can speak and listen. Commands ask you first unless you've allowed them."
                                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton setup:SetupText.Uid="Onboarding_SecurityLevel_FullAccess" AutomationProperties.Name="Full access">
                                        <StackPanel Spacing="1">
                                            <TextBlock setup:SetupText.Uid="Onboarding_SecurityLevel_FullAccessTitle" Text="Full access"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock setup:SetupText.Uid="Onboarding_SecurityLevel_FullAccessDetail"
                                                       Text="Everything in Balanced, plus your camera, your location, and control of a web browser."
                                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </RadioButton>
                                </RadioButtons>

                                <!-- Follows the capability toggles, so it also describes custom choices. -->
                                <Border x:Name="LevelDisclosure" CornerRadius="4" Padding="12,10" BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Spacing="10">
                                        <TextBlock setup:SetupText.Uid="Onboarding_SecurityLevel_DisclosureTitle" Text="What this level allows"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"
                                                   AutomationProperties.HeadingLevel="Level3" />
                                        <Grid x:Name="LevelAllowsGrid" ColumnSpacing="16" RowSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Rows added in code-behind -->
                                        </Grid>
                                        <StackPanel x:Name="LevelAsksFirstPanel" Spacing="2">
                                            <TextBlock setup:SetupText.Uid="Onboarding_SecurityLevel_AsksFirstTitle" Text="Asks you first"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level4" />
                                            <TextBlock x:Name="LevelAsksCommandsText" setup:SetupText.Uid="Onboarding_SecurityLevel_AsksCommands"
                                                       Text="Commands that aren't on your allowed list ask you to Deny, Allow Once, or Allow Always. If you don't answer, the command is denied."
                                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="LevelAsksDevicesText" setup:SetupText.Uid="Onboarding_SecurityLevel_AsksDevices"
                                                       Text="Screen capture, camera, and location ask for your permission the first time they're used. Listening through your microphone and controlling a web browser don't ask first."
                                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel x:Name="LevelSandboxPanel" Spacing="2">
                                            <TextBlock setup:SetupText.Uid="Onboarding_SecurityLevel_SandboxTitle" Text="Where commands run"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level4" />
                                            <TextBlock setup:SetupText.Uid="Onboarding_SecurityLevel_Sandbox"
                                                       Text="By default, commands run in a sandbox with no internet or clipboard access. They can read the folder they run in and folders you allow on the Sandbox page. The sandbox also blocks the usual folders for OpenClaw's settings, SSH keys, browser profiles (Chrome, Edge, Brave, Firefox), and PowerShell history."
                                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock setup:SetupText.Uid="Onboarding_SecurityLevel_SandboxFallback"
                                                       Text="If this PC can't run the sandbox, commands run with your normal access instead."
                                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Local AI setup is independent of this choice and does not require Full access."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />

                                <Expander x:Name="CapabilityExpander" Margin="0,4,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          Background="Transparent" BorderThickness="0"
                                          Header="Advanced: choose individual capabilities">
                                    <Grid x:Name="CapGrid" ColumnSpacing="16" RowSpacing="4" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Rows added in code-behind -->
                                    </Grid>
                                </Expander>
                                <TextBlock Text="Basic device info and status stay available while Node Mode is on."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel x:Name="Step2Content" Spacing="8" Visibility="Collapsed">
                                <TextBlock TextWrapping="Wrap"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Grant the Windows permissions your selected capabilities need: now, or later from Settings. The agent only uses what you allow." />
                                <StackPanel x:Name="PermRows" Spacing="4" />
                            </StackPanel>

                            <StackPanel x:Name="Step3Content" Spacing="4" Visibility="Collapsed">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="14,12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <FontIcon Grid.Column="0" Glyph="&#xE756;" FontSize="18" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock x:Name="InstallDistroTitleText" Text="Install Ubuntu 24.04 in WSL" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="InstallDistroDetailText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Creates a separate OpenClawGateway instance. Uses several GB." />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="Several GB" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <InfoBar x:Name="LocalAiUnavailablePanel"
                                         AutomationProperties.AutomationId="LocalAiUnavailablePanel"
                                         AutomationProperties.LiveSetting="Polite"
                                         IsOpen="True" IsClosable="False" Severity="Informational"
                                         Title="Local AI is not available"
                                         Message="This PC does not meet one or more Local AI requirements."
                                         Visibility="Collapsed">
                                    <InfoBar.ActionButton>
                                        <HyperlinkButton x:Name="LocalAiUnavailableDetailsButton"
                                                         setup:SetupText.Uid="Onboarding_LocalAi_UnavailableDetailsButton"
                                                         AutomationProperties.AutomationId="LocalAiUnavailableDetailsButton"
                                                         Content="See why"
                                                         Click="LocalAiUnavailableDetails_Click" />
                                    </InfoBar.ActionButton>
                                </InfoBar>
                                <StackPanel x:Name="LocalAiAvailabilityRecoveryPanel"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <ProgressRing x:Name="LocalAiAvailabilityProgressRing"
                                                  Width="16"
                                                  Height="16"
                                                  IsActive="False"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                    <HyperlinkButton x:Name="LocalAiRecheckAvailabilityButton"
                                                     setup:SetupText.Uid="Onboarding_LocalAi_RecheckAvailabilityButton"
                                                     AutomationProperties.AutomationId="LocalAiRecheckAvailabilityButton"
                                                     Content="Recheck"
                                                     Click="LocalAiRecheckAvailability_Click" />
                                </StackPanel>
                                <Border x:Name="LocalAiInstallReviewCard"
                                        AutomationProperties.AutomationId="LocalAiInstallReviewCard"
                                        Visibility="Collapsed"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="14,12">
                                    <StackPanel Spacing="10">
                                        <StackPanel x:Name="LocalAiOptionContent"
                                                    AutomationProperties.Name="Local AI setup options"
                                                    Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                <FontIcon Grid.Column="0" Glyph="&#xE950;" FontSize="18" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="Local AI" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock Text="Install Local AI and an optimized model."
                                                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <ToggleSwitch x:Name="LocalAiToggle" Grid.Column="2"
                                                              AutomationProperties.AutomationId="LocalAiSetupToggle"
                                                              AutomationProperties.Name="Set up Local AI"
                                                              OnContent="" OffContent="" MinWidth="0"
                                                              Toggled="LocalAiToggle_Toggled" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel x:Name="LocalAiDetailsPanel" Spacing="6" Margin="32,0,0,0" Visibility="Collapsed">
                                                <TextBlock x:Name="LocalAiHardwareStatusText"
                                                           AutomationProperties.AutomationId="LocalAiHardwareStatus"
                                                           AutomationProperties.LiveSetting="Polite"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="Model" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <ComboBox x:Name="LocalAiModelSelector"
                                                          AutomationProperties.AutomationId="LocalAiModelSelector"
                                                          AutomationProperties.Name="Local AI model"
                                                          HorizontalAlignment="Stretch"
                                                          SelectionChanged="LocalAiModelSelector_SelectionChanged" />
                                                <TextBlock x:Name="LocalAiEngineDetailText"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="LocalAiModelDetailText"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <InfoBar x:Name="LocalAiNetworkingConsentPanel"
                                                         AutomationProperties.AutomationId="LocalAiNetworkingConsentPanel"
                                                         AutomationProperties.LiveSetting="Assertive"
                                                         IsOpen="True" IsClosable="False" Severity="Warning"
                                                         Title="WSL networking change required" Visibility="Collapsed">
                                                    <StackPanel Spacing="6" Margin="0,0,0,12">
                                                        <TextBlock Text="Local AI needs mirrored WSL networking. Setup will update your global .wslconfig and stop all running WSL distributions once. No distributions are deleted. Save any work in WSL first."
                                                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                                        <CheckBox x:Name="LocalAiNetworkingConsentCheckBox"
                                                                  AutomationProperties.AutomationId="LocalAiNetworkingConsentCheckBox"
                                                                  AutomationProperties.Name="Allow the global WSL networking change and one-time WSL shutdown"
                                                                  Content="I understand and allow this global WSL change and one-time shutdown."
                                                                  Checked="LocalAiNetworkingConsent_Changed"
                                                                  Unchecked="LocalAiNetworkingConsent_Changed" />
                                                    </StackPanel>
                                                </InfoBar>
                                                <InfoBar x:Name="LocalAiNetworkingInspectionError"
                                                         AutomationProperties.AutomationId="LocalAiNetworkingInspectionError"
                                                         AutomationProperties.LiveSetting="Assertive"
                                                         IsOpen="True" IsClosable="False" Severity="Error"
                                                         Title="Could not check WSL networking" Visibility="Collapsed" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="14,12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                            <FontIcon Grid.Column="0" Glyph="&#xE701;" FontSize="18" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Tailnet access with Tailscale Serve" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Publish this private gateway as HTTPS/WSS to your Tailscale tailnet. Windows Tailscale must already be signed in; setup root owns Serve." />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="TailscaleToggle" Grid.Column="2" OnContent="" OffContent="" Toggled="TailscaleToggle_Toggled" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel x:Name="TailscaleOptions" Visibility="Collapsed" Spacing="6" Margin="32,0,0,0">
                                            <TextBlock x:Name="TailscaleStatusText" Text="Check Windows Tailscale before continuing." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <RadioButtons x:Name="TailscaleAuthModeSelector" SelectedIndex="0" SelectionChanged="TailscaleAuthMode_SelectionChanged">
                                                <x:String>Sign in in browser</x:String>
                                                <x:String>Use one-off auth key</x:String>
                                            </RadioButtons>
                                            <PasswordBox x:Name="TailscaleAuthKeyBox" Visibility="Collapsed" PlaceholderText="Tailscale auth key (not saved)" />
                                            <ToggleSwitch x:Name="TailscaleTrustAuthToggle" Header="Trust Tailscale identities for gateway authentication" OnContent="Enabled" OffContent="Disabled" Toggled="TailscaleTrustAuthToggle_Toggled" />
                                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Off by default. Enable only when your Tailscale ACLs should be part of the gateway access-control boundary; OpenClaw receives only a restricted identity lookup, not Tailscale operator control." />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="14,12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <FontIcon Grid.Column="0" Glyph="&#xE896;" FontSize="18" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Download &amp; install the OpenClaw CLI" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="InstallCliDetailText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Fetched over HTTPS; runs as a non-root openclaw user inside the instance." />
                                        </StackPanel>
                                        <TextBlock x:Name="InstallCliBadgeText" Grid.Column="2" Text="HTTPS" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="14,12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <FontIcon Grid.Column="0" Glyph="&#xE968;" FontSize="18" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Run a local gateway service" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="GatewayServiceDetailText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Loopback only. It is not reachable from your network or the internet." />
                                        </StackPanel>
                                        <TextBlock x:Name="GatewayEndpointText" Grid.Column="2" Text="127.0.0.1:18789" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="14,12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="18" VerticalAlignment="Center" IsTextScaleFactorEnabled="False" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="May ask for admin once" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Only if the Windows WSL platform isn't installed yet. One-time per machine." />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="UAC?" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Expander Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          Header="Show the exact commands &amp; files">
                                    <TextBlock x:Name="ExactCommandsText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,4" />
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsTabStop="False" AutomationProperties.Name="Step 3 of 6">
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupInactiveDotBrush}" />
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupInactiveDotBrush}" />
                <Border Width="20" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupIndicatorAccentBrush}" />
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupInactiveDotBrush}" />
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupInactiveDotBrush}" />
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupInactiveDotBrush}" />
            </StackPanel>
            <Button x:Name="BackButton" Grid.Column="0" Content="Back"
                    MinWidth="100" HorizontalAlignment="Left"
                    Visibility="Collapsed" Click="Back_Click" />
            <Button x:Name="PrimaryButton" Grid.Column="1" Content="Next"
                    MinWidth="100" HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}" Click="Primary_Click" />
        </Grid>
    </Grid>
</Page>

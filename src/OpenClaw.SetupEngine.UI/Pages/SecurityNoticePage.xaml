<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.SetupEngine.UI.Pages.SecurityNoticePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:setup="using:OpenClaw.SetupEngine.UI"
    NavigationCacheMode="Disabled">

    <Grid Padding="48,20,48,24" RowDefinitions="*,Auto,Auto">

        <!-- Only the introduction and benefits scroll; the side padding keeps the scroll bar off the text.
             It holds only text, so it takes focus itself to let keyboard users scroll it, named by the title. -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" IsTabStop="True"
                      AutomationProperties.LabeledBy="{x:Bind IntroTitle}">
            <StackPanel MaxWidth="544" Spacing="20" Padding="12,8,12,8" HorizontalAlignment="Center">

                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <Image Source="ms-appx:///OpenClaw.SetupEngine.UI/Assets/Setup/OpenClawMascot.png"
                           Width="88" Height="88" HorizontalAlignment="Center"
                           AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="IntroTitle" setup:SetupText.Uid="Onboarding_Intro_Title"
                               Text="Welcome to OpenClaw"
                               Style="{StaticResource TitleTextBlockStyle}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock setup:SetupText.Uid="Onboarding_Intro_Summary"
                               Text="OpenClaw is a personal AI assistant that can work on this PC for you. Chat with it here or from the apps you already use."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <FontIcon Glyph="&#xE9D5;" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock setup:SetupText.Uid="Onboarding_Intro_BenefitTasksTitle"
                                       Text="Get help with everyday tasks"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock setup:SetupText.Uid="Onboarding_Intro_BenefitTasksDetail"
                                       Text="Ask it to organize files, look things up, or take care of routine work."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <FontIcon Glyph="&#xE8BD;" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock setup:SetupText.Uid="Onboarding_Intro_BenefitChatTitle"
                                       Text="Chat from anywhere"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock setup:SetupText.Uid="Onboarding_Intro_BenefitChatDetail"
                                       Text="You can also message it from apps like WhatsApp or Telegram."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <FontIcon Glyph="&#xE72E;" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock setup:SetupText.Uid="Onboarding_Intro_BenefitControlTitle"
                                       Text="You stay in control"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock setup:SetupText.Uid="Onboarding_Intro_BenefitControlDetail"
                                       Text="You choose what it can do on this PC, and you can change that anytime."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- The risk notice stays outside the scroller so it is on screen whenever Continue is. -->
        <StackPanel Grid.Row="1" MaxWidth="544" Padding="12,12,12,0" Spacing="4">
            <InfoBar setup:SetupText.Uid="Onboarding_Intro_RiskNotice"
                     IsOpen="True" IsClosable="False" Severity="Warning"
                     Title="Before you continue"
                     Message="AI assistants are powerful and can make mistakes. With your permission, OpenClaw can see and change things on this PC, like your screen and files, or run programs. Only set it up on your own PC, not one you share." />

            <StackPanel HorizontalAlignment="Center">
                <HyperlinkButton setup:SetupText.Uid="Onboarding_Intro_SecurityLink"
                                 Content="How OpenClaw keeps you safe"
                                 NavigateUri="https://docs.openclaw.ai/gateway/security"
                                 HorizontalAlignment="Center" />
                <HyperlinkButton setup:SetupText.Uid="Onboarding_Intro_ArchitectureLink"
                                 Content="How OpenClaw works"
                                 NavigateUri="https://docs.openclaw.ai/concepts/architecture"
                                 HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsTabStop="False" AutomationProperties.Name="Step 1 of 6">
                <Border Width="20" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupIndicatorAccentBrush}" />
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupInactiveDotBrush}" />
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupInactiveDotBrush}" />
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupInactiveDotBrush}" />
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupInactiveDotBrush}" />
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource SetupInactiveDotBrush}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="ContinueButton" setup:SetupText.Uid="Onboarding_Intro_ContinueButton"
                    Content="Continue"
                    MinWidth="100" HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Continue_Click" />
        </Grid>
    </Grid>
</Page>
